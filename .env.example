# DataBossX — root environment template.
# Copy to .env and fill in real values. NEVER commit a real .env.
# Variable names below were discovered from code usage; values are placeholders.

# --- LLM providers (backend/server.py, automation/) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Backend (FastAPI) ---
# Path to the local SQLite database used by backend/server.py
SQLITE_DB_PATH=./databossx.db
# Comma-separated list of allowed CORS origins for the API.
# Use specific origins in production, e.g. https://app.example.com,http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000
# Max upload size in megabytes for /api/documents/upload
MAX_UPLOAD_MB=25

# --- Legacy / platform integrations (see .emergent, scripts) ---
SUPABASE_URL=
SUPABASE_KEY=
FRONTEND_URL=
BACKEND_DOCKER_URL=http://host.docker.internal:8009
MOCK_AUTH=true
