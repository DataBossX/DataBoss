# Horizon Report Configuration Template
# Copy this file to .env and fill in your values

# ===== CORE PATHS =====
# Root directory for Horizon operations (defaults to current directory)
# HORIZON_ROOT=/path/to/horizon

# Input folder where source files are located
# HORIZON_INPUT_PATH=/path/to/inputs

# Template folder
# HORIZON_TEMPLATE_PATH=/path/to/templates

# Reports output folder
# HORIZON_REPORTS_PATH=/path/to/reports

# Logs folder
# HORIZON_LOGS_PATH=/path/to/logs


# ===== GOOGLE DRIVE SYNC =====
# Option 1: Local sync path (if Google Drive is mounted/synced locally)
# GOOGLE_DRIVE_SYNC_PATH=/path/to/Google Drive/Horizon Reports

# Option 2: API sync (requires service account credentials)
# GOOGLE_DRIVE_FOLDER_ID=your-folder-id-here
# GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account-credentials.json


# ===== REPORT SETTINGS =====
# Default section target (can be overridden via CLI)
# SECTION_TARGET=31-12N-24W

# Default county and state
# REPORT_COUNTY=Roger Mills
# REPORT_STATE=Oklahoma

# Default template name
# REPORT_TEMPLATE_NAME=Standard Ownership Template


# ===== SECURITY NOTES =====
# - Never commit .env to version control
# - Keep service account JSON files secure
# - Limit Google Drive API permissions to minimum required
# - Service account should only have access to specific folders
