# ===================
# ADDITIONAL RULES TO PREVENT FILE SIZE VIOLATIONS
# ===================
# Archive files (anywhere in the project)
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz

# Build caches and artifacts
.cache/
*.pack

# System packages
*.deb

# Python native libraries
*.dylib

# Android SDK
android-sdk/

# Grocery Report pipeline generated artifacts (regenerable; may contain client data)
/output/
_synthetic_corpus/
.pytest_cache/

# ===================
# HORIZON REPORT SECURITY & GENERATED FILES
# ===================
# Environment files with secrets
.env
.env.*
!.env.example

# Google service account credentials
*service-account*.json
*credentials*.json
*client_secret*.json

# Generated reports (may contain confidential data)
/reports/generated/*.docx
/reports/generated/*.xlsx
/reports/generated/*.pdf

# Logs (may contain sensitive info)
/logs/*.txt
/logs/*.log

# Archive folder
/archive/

# Temp files
*.tmp
~$*