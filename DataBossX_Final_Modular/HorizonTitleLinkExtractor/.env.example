# =============================================================================
# HorizonTitleLinkExtractor - Environment variables
# -----------------------------------------------------------------------------
# Copy this file to ".env" and fill in your keys.
# NEVER commit the real .env file. It is already in .gitignore.
# =============================================================================

# Primary vision extractor (required)
OPENAI_API_KEY=

# Optional validator 1 (leave blank to disable Gemini validation)
GEMINI_API_KEY=

# Optional validator 2 (leave blank to disable Claude validation)
ANTHROPIC_API_KEY=

# --- Google Drive API mode (Mode B) - optional -------------------------------
# Path to a service-account JSON key file (if using service account auth).
GOOGLE_APPLICATION_CREDENTIALS=

# Path to an OAuth client-secret JSON file (if using user OAuth auth).
GOOGLE_OAUTH_CLIENT_SECRET_JSON=

# --- Google Drive Desktop mode (Mode A) - optional ---------------------------
# Local path of the synced "Horizon Work" folder on this PC.
# Example: G:\My Drive\Horizon Work
GOOGLE_DRIVE_LOCAL_SYNC_PATH=
