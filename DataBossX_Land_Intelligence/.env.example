# Copy this file to ".env" and fill in what you have. Nothing here is ever
# printed to logs or written to the output workbook.

# --- OpenAI (preferred if present) ----------------------------------------
# If OPENAI_API_KEY is set, the CrewAI agents use OpenAI.
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# --- Local Ollama fallback (used only if no OpenAI key) --------------------
# Point this at a running Ollama-compatible server. If reachable, the agents
# use it; otherwise the pipeline runs in deterministic-only mode.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
