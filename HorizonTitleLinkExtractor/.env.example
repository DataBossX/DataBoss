# =============================================================================
# HorizonTitleLinkExtractor - environment variables
# =============================================================================
# 1. Copy this file to a new file named exactly:  .env
# 2. Paste your keys after each = sign.
# 3. NEVER commit, email, or share the real .env file.
# =============================================================================

# Primary vision extractor (REQUIRED)
OPENAI_API_KEY=

# Optional validators (leave blank to disable)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Google Drive API mode (Mode B) ----------------------------------------
# Path to a Google service-account JSON OR an OAuth client secret JSON.
# Only needed if you are NOT using Google Drive Desktop sync.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_OAUTH_CLIENT_SECRET_JSON=

# ---- Google Drive Desktop mode (Mode A) ------------------------------------
# If set, the tool reads/writes through your locally synced Drive folder.
# Example: G:\My Drive\Horizon Work
GOOGLE_DRIVE_LOCAL_SYNC_PATH=
