# Notice List Maker - Environment Configuration Example
# Copy this file to .env and fill in your values

# Database Configuration
# Choose: sqlite or postgres
DB_TYPE=sqlite

# SQLite (for local development)
SQLITE_PATH=db/local_cache.sqlite

# PostgreSQL/Supabase (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/notice_list
# Or for Supabase:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Connector API Keys (optional)
# COUNTY_RECORDER_API_KEY=your_api_key_here
# ARC_SEARCH_API_KEY=your_arc_api_key
# IDOC_API_KEY=your_idoc_key

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/notice_list.log

# Audit Schedule
AUDIT_ENABLED=true
AUDIT_TIME=02:00  # 24-hour format

# Performance
MAX_WORKERS=4
TIMEOUT_SECONDS=30
MAX_RETRIES=3
