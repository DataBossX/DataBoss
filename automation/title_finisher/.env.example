# TitleFinisher configuration — copy to .env and fill in.
# okcountyrecords.com API key (per-account). Never commit the real .env.
OKCR_API_KEY=

# Optional: OCC / OTC do not require keys for public search, but set a contact UA.
REQUEST_USER_AGENT=TitleFinisher/1.0 (title examiner support)

# Defaults (overridable by CLI flags)
COUNTY=Roger Mills
TWPRGE=12N-24W
SECTION=31

# Tesseract binary (leave blank to use PATH; on Windows e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=
