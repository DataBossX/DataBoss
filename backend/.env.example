# Copy this file to backend/.env and provide secrets locally.
# Never commit populated .env files.

SQLITE_DB_PATH=./databossx.db

# Fail-closed demo controls. Leave DEMO_MODE off for real work.
DATABOSSX_DEMO_MODE=0
DATABOSSX_DEMO_TOKEN=replace-with-local-demo-token
DATABOSSX_BIND=127.0.0.1
DATABOSSX_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DATABOSSX_ALLOW_NONLOCAL_BIND=0

# Optional LLM keys — never required for the fail-closed demo server.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
