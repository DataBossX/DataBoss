# Backend (FastAPI) environment template — copy to backend/.env and fill in.
# NEVER commit backend/.env. Names discovered from backend/server.py usage.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local SQLite database path
SQLITE_DB_PATH=./databossx.db

# Comma-separated allowed CORS origins (default: http://localhost:3000)
CORS_ALLOW_ORIGINS=http://localhost:3000

# Max upload size (MB) for document uploads
MAX_UPLOAD_MB=25

# Comma-separated allowed upload extensions (empty = allow any).
# Default: pdf,png,jpg,jpeg,tif,tiff,bmp,gif,webp,txt
# ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg,txt

# Rate limiting for write endpoints (per client IP, sliding window)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SEC=60

# Logging
LOG_PATH=logs/databossx.log
LOG_LEVEL=INFO
