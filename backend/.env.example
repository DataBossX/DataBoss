# DataBossX backend configuration
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env — it is gitignored.

# --- Database ---
MONGO_URL=
DB_NAME=databossx
# Path to the local SQLite database used by the API
SQLITE_DB_PATH=./databossx.db

# --- LLM provider API keys (leave blank to disable that provider) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY is an alias some tooling expects; usually same as ANTHROPIC_API_KEY
CLAUDE_API_KEY=
GEMINI_API_KEY=
QWEN_API_KEY=
GROK_API_KEY=
GOOGLE_DRIVE_API_KEY=

# --- CORS ---
# Comma-separated list of allowed origins for the API.
# Use specific origins in production; "*" disables credentialed CORS.
CORS_ORIGINS=http://localhost:3000
