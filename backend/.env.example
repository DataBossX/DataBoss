# DataBossX backend — environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` in the same directory and fill in real values:
#     cp backend/.env.example backend/.env
# `.env` is gitignored and must NEVER be committed. Rotate any key that leaks.
# -----------------------------------------------------------------------------

# --- Database ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=databossx

# SQLite database (absolute or repo-relative path)
SQLITE_DB_PATH=./databossx.db

# --- AI / LLM provider API keys ---
# Anthropic (Claude). Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Some modules read CLAUDE_API_KEY; set it to the same Anthropic value if used.
CLAUDE_API_KEY=sk-ant-...

# OpenAI. https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Google Gemini. https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# xAI Grok. https://console.x.ai
GROK_API_KEY=

# Alibaba Qwen / DashScope.
QWEN_API_KEY=

# Google Drive API key (if Drive integration is enabled).
GOOGLE_DRIVE_API_KEY=
