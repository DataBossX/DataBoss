# Backend (FastAPI) environment template — copy to backend/.env and fill in.
# NEVER commit backend/.env. Names discovered from backend/server.py usage.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local SQLite database path
SQLITE_DB_PATH=./databossx.db

# Comma-separated allowed CORS origins (default: http://localhost:3000)
CORS_ALLOW_ORIGINS=http://localhost:3000

# Max upload size (MB) for document uploads
MAX_UPLOAD_MB=25
