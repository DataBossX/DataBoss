# backend/.env.example — copy to backend/.env and fill in real values.
# NEVER commit the real .env. All keys below are required by backend/server.py.

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URL="mongodb://localhost:27017"
DB_NAME="test_database"
SQLITE_DB_PATH="./databossx.db"

# ── LLM / AI provider API keys (do not commit real values) ────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
QWEN_API_KEY=
GOOGLE_DRIVE_API_KEY=
GROK_API_KEY=

# ── External records API ──────────────────────────────────────────────────────
OKCOUNTY_API_KEY=

# ── CORS allowlist (comma-separated origins) ──────────────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
