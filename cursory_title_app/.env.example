# Copy to .env (same folder) and fill in. NEVER commit your real .env.
# Secrets are read from the environment only — nothing is hardcoded.

# --- Vision/extraction model (swappable, priority order) ---
CTA_MODEL_ORDER=claude,openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CTA_CLAUDE_MODEL=claude-opus-4-8
CTA_OPENAI_MODEL=gpt-4o
CTA_CONFIDENCE_THRESHOLD=0.80

# --- Target legal description (defaults are Section 31, 12N, 24W) ---
TARGET_SECTION=31
TARGET_TOWNSHIP=12N
TARGET_RANGE=24W
TARGET_COUNTY=Roger Mills

# --- Browser: connect to YOUR already-logged-in Chrome/Edge over CDP ---
# Start your browser first:
#   chrome.exe --remote-debugging-port=9222 --user-data-dir="%LOCALAPPDATA%\CTA\chrome"
CTA_CDP_URL=http://127.0.0.1:9222

# --- Local storage (optional overrides) ---
# CTA_DATA_DIR=
# CTA_OUTPUT_DIR=
# CTA_BACKUP_DIR=
