# DOTO Image Commander - Environment Variables Example
# Copy to .env and fill in real values. Never commit .env to version control.

# OKCountyRecords API
OKCOUNTY_API_KEY=your_api_key_here
OKCOUNTY_API_BASE_URL=https://api.okcountyrecords.com/v1
OKCOUNTY_COST_PER_IMAGE=0.50
OKCOUNTY_COST_PER_SEARCH=0.10

# OpenAI API
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# Storage paths (defaults work for most cases)
DOWNLOADS_DIR=./downloads
IMAGES_DIR=./images
REPORTS_DIR=./reports
DB_PATH=./doto_commander.db
AUDIT_LOG_PATH=./audit.log

# Security
# ENCRYPTION_KEY is auto-generated on first run; you can override it here
# ENCRYPTION_KEY=base64_encoded_fernet_key
