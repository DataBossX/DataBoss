# DataBossX frontend — environment template
# -----------------------------------------------------------------------------
# Copy to `.env` (gitignored) and adjust for your environment:
#     cp frontend/.env.example frontend/.env
# Only NON-secret, build-time values belong here. Anything prefixed with
# REACT_APP_ is embedded in the client bundle and is PUBLIC — never put a
# secret API key in this file.
# -----------------------------------------------------------------------------

# URL of the backend API the frontend talks to.
REACT_APP_BACKEND_URL=http://localhost:8009

# Webpack dev-server websocket port (used by the local dev server).
WDS_SOCKET_PORT=443
