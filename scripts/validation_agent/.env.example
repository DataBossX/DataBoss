# DataBossX Validation Agent — environment template.
# Copy to .env and fill in. NEVER commit a real .env. NEVER put secrets in source.

# --- Paths (Windows target defaults; on other OSes the app auto-resolves from the module location) ---
DATABOSSX_ROOT=D:\Desktop\DataBossX
DATABOSSX_AGENT_ROOT=D:\Desktop\DataBossX\scripts\validation_agent

# --- Safety caps (hard-enforced; app refuses to start if these exceed the ceilings) ---
DATABOSSX_API_CAP_USD=100.00
DATABOSSX_MAX_ITERATIONS=5

# --- Mode: dry-run is the default. Live source mode must be explicitly enabled. ---
DATABOSSX_DRY_RUN=true
DATABOSSX_LIVE_SOURCE=false

# --- Paid-document auto-approval policy (only used in live mode) ---
# When true, paid retrievals up to the per-document limit auto-approve; cumulative $100 cap still hard-enforced.
DATABOSSX_AUTO_APPROVE_PAID=false
DATABOSSX_PER_DOCUMENT_LIMIT_USD=5.00

# --- Expected section acreage gate (override only with examiner authority) ---
DATABOSSX_EXPECTED_ACREAGE=637.42

# --- OKCountyRecords credentials (leave blank to stay in dry-run; app never prints these) ---
OKCOUNTY_USERNAME=
OKCOUNTY_PASSWORD=
OKCOUNTY_API_BASE_URL=
OKCOUNTY_COST_PER_SEARCH=0.10
OKCOUNTY_COST_PER_IMAGE=0.50

# --- LibreOffice (leave blank to auto-detect common install paths) ---
LIBREOFFICE_PATH=
