# DataBossX Validation Agent - environment template
# Copy to .env and fill in values. NEVER commit a real .env with secrets.

# --- Paths (Windows production defaults; leave blank to auto-detect on other OS) ---
DATABOSSX_ROOT=D:\Desktop\DataBossX
DATABOSSX_AGENT_ROOT=D:\Desktop\DataBossX\scripts\validation_agent

# --- Hard safety limits (do not raise the cap above 100.00) ---
DATABOSSX_API_CAP_USD=100.00
DATABOSSX_MAX_ITERATIONS=5

# --- Operating mode ---
# DRY_RUN=true means no paid API calls, no live source retrieval.
DATABOSSX_DRY_RUN=true
# LIVE_SOURCE must be explicitly true to allow any external source lookups.
DATABOSSX_LIVE_SOURCE=false
# AUTO_APPROVE_PAID lets the agent retrieve paid docs under a per-doc limit
# WITHOUT interactive approval. Still hard-capped at the cumulative $100.00.
DATABOSSX_AUTO_APPROVE_PAID=false
DATABOSSX_PER_DOC_LIMIT_USD=5.00

# --- Expected reconciliation targets (override only with examiner sign-off) ---
DATABOSSX_EXPECTED_ACREAGE=637.42

# --- OKCountyRecords (leave blank in dry-run) ---
OKCOUNTY_USERNAME=
OKCOUNTY_PASSWORD=
OKCOUNTY_API_BASE_URL=
OKCOUNTY_COST_PER_SEARCH=0.10
OKCOUNTY_COST_PER_DOCUMENT=1.00

# --- LibreOffice (leave blank to auto-detect) ---
LIBREOFFICE_PATH=

# --- Extra folders (semicolon-separated) the source/report finders may scan ---
DATABOSSX_EXTRA_SOURCE_DIRS=
DATABOSSX_EXTRA_REPORT_DIRS=
