# DataBossX Validation Agent — environment template.
# Copy to .env and fill in. NEVER commit a real .env. Secrets are never printed by the app.

# Project roots. On Windows the canonical roots are:
#   DATABOSSX_ROOT=D:\Desktop\DataBossX
#   DATABOSSX_AGENT_ROOT=D:\Desktop\DataBossX\scripts\validation_agent
# If unset, the agent auto-detects its own root from the package location (cross-platform).
DATABOSSX_ROOT=
DATABOSSX_AGENT_ROOT=

# Hard financial and loop safety caps (the app clamps these; they can only be made stricter).
DATABOSSX_API_CAP_USD=100.00
DATABOSSX_MAX_ITERATIONS=5

# Safety mode. Default TRUE. Live source retrieval requires DATABOSSX_DRY_RUN=false AND live mode on.
DATABOSSX_DRY_RUN=true
DATABOSSX_LIVE_SOURCE_MODE=false

# Paid-document auto-approval policy (still bounded by the $100 cumulative cap).
DATABOSSX_AUTO_APPROVE_PAID=false
DATABOSSX_PER_DOC_LIMIT_USD=10.00

# Expected total section acreage gate (override only with examiner authority).
DATABOSSX_EXPECTED_ACRES=637.42

# OKCountyRecords official/authenticated access (leave blank to stay in dry-run).
OKCOUNTY_USERNAME=
OKCOUNTY_PASSWORD=
OKCOUNTY_API_BASE_URL=

# LibreOffice headless binary (auto-detected if blank).
LIBREOFFICE_PATH=

# Extra folders (os.pathsep-separated) the report/source finders should also scan.
DATABOSSX_EXTRA_SOURCE_DIRS=
DATABOSSX_EXTRA_REPORT_DIRS=
