# Copy this file to ".env" (same folder) and fill in what you have.
# The app loads .env automatically and NEVER prints secret values.
# Everything below is OPTIONAL -- the app is local-first and runs without any of it.

# Where the main Roger Mills folder lives (defaults to D:\Desktop\Horizon\Roger Mills)
SECTION31_ROOT=D:\Desktop\Horizon\Roger Mills

# --- OKCountyRecords / Oklahoma records (optional) -------------------------
OKCOUNTYRECORDS_BASE_URL=
OKCOUNTYRECORDS_API_KEY=

# --- Google Drive fallback (optional) -------------------------------------
# Path to a service-account JSON key with read-only Drive scope.
GOOGLE_APPLICATION_CREDENTIALS=
# The Drive folder to search for Section 31 files.
GOOGLE_DRIVE_FOLDER_ID=
