# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to source control.

# ── OKCountyRecords API ───────────────────────────────────────────────────────
# Your API key. Used as HTTP Basic Auth username with blank password.
OKCOUNTYRECORDS_API_KEY=your_key_here

# ── Claude AI (optional — for OCR fallback and AI field extraction) ───────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Cost gate ─────────────────────────────────────────────────────────────────
# Set to true to skip manual approval if cost is below MAX_COST_USD
AUTO_APPROVE_COST=false
MAX_COST_USD=50.00

# ── Search defaults ───────────────────────────────────────────────────────────
COUNTY=Beckham
SECTION=27
TOWNSHIP=11N
RANGE=25W

# ── Output directory ──────────────────────────────────────────────────────────
# Where PDFs, the database, and reports are saved.
OUTPUT_DIR=output
