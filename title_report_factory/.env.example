# Copy to .env and fill in only what you need. Never commit real secrets.

# --- OKCountyRecords (optional, authorized use only) ---
# Live record download is DISABLED unless okcounty.enabled=true in the config
# AND both credentials below are present.
OKCR_USERNAME=
OKCR_PASSWORD=

# --- Multi-LLM tournament backend (optional) ---
# If set, multi_ai_tournament_reviewer.llm_review() can call a real model
# via litellm. Absent keys => deterministic heuristic passes are used.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TRF_REVIEW_MODEL=claude-sonnet-4-6
