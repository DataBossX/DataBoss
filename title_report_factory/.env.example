# Title Report Factory -- environment variables (copy to .env and fill in)
# NEVER commit a real .env. Secrets are read ONLY from the environment.

# --- Optional LLM (multi-AI tournament). Leave blank to run heuristic-only. ---
# Set one of these and "enable_llm": true in the config to activate.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model used via litellm (defaults to claude-opus-4-8).
TRF_LLM_MODEL=

# --- Optional OKCountyRecords browser downloader ---
# Set both and "enable_download": true in the config to activate.
OKCR_USERNAME=
OKCR_PASSWORD=
OKCR_BASE_URL=https://okcountyrecords.com
