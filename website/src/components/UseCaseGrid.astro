---
/**
 * UseCaseGrid — industry applications. Written as "built for" capability
 * statements; no customer, testimonial, or adoption claims.
 */
const useCases = [
  {
    title: 'Land & mineral title',
    body: 'Chain instruments across decades of county records, compute ownership with exact fractions, and hand examiners a review queue where every interest traces to a recorded document.',
    accent: 'cyan',
    tag: 'deeds · leases · assignments',
  },
  {
    title: 'Legal document review',
    body: 'Extract parties, dates, terms, and obligations with page-and-span citations, so every assertion in a memo can be opened against its source language in two clicks.',
    accent: 'blue',
    tag: 'contracts · filings · discovery',
  },
  {
    title: 'Compliance & audit operations',
    body: 'Append-only evidence, hash-bound approvals, and a reconstructable audit trail give auditors what they actually ask for: who decided what, from which document, and when.',
    accent: 'violet',
    tag: 'controls · attestations · trails',
  },
  {
    title: 'Enterprise document intelligence',
    body: 'Turn mixed-format archives into a searchable claim graph with field-level provenance — without shipping confidential sources to systems you don’t control.',
    accent: 'green',
    tag: 'archives · knowledge · search',
  },
  {
    title: 'High-volume operational backlogs',
    body: 'Point competing extraction agents at the backlog, let confidence gates auto-clear the routine work, and concentrate human attention on the conflicts that matter.',
    accent: 'amber',
    tag: 'intake · triage · throughput',
  },
];
---

<ul class="use-cases" role="list">
  {useCases.map((useCase, i) => (
    <li
      class="use-cases__item card reveal"
      data-reveal-delay={String(i % 3)}
      data-accent={useCase.accent}
    >
      <p class="mono use-cases__tag">{useCase.tag}</p>
      <h3>{useCase.title}</h3>
      <p class="dim">{useCase.body}</p>
    </li>
  ))}
</ul>

<style>
  [data-accent='cyan'] { --accent: var(--cyan); }
  [data-accent='blue'] { --accent: var(--blue); }
  [data-accent='violet'] { --accent: var(--violet); }
  [data-accent='green'] { --accent: var(--green); }
  [data-accent='amber'] { --accent: var(--amber); }

  .use-cases {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-3);
  }

  .use-cases__item {
    border-top: 2px solid var(--accent);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .use-cases__item h3 {
    font-size: 1.08rem;
    margin-bottom: var(--space-1);
  }

  .use-cases__item p:last-child {
    font-size: 0.94rem;
    margin: 0;
  }

  .use-cases__tag {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }
</style>
