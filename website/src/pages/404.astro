---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — DataBossX"
  description="The page you requested does not exist. Return to the DataBossX overview or the technical architecture."
  path="/404"
>
  <section class="section not-found">
    <div class="grid-field"></div>
    <div class="container not-found__inner">
      <p class="kicker">HTTP 404</p>
      <h1>No evidence for this route.</h1>
      <p class="lede">
        The address you followed doesn’t resolve to a page — and unlike our extractions, we won’t
        make one up.
      </p>
      <p class="mono not-found__trace dim">
        claim: route exists · state: UNSUPPORTED · action: return to a verified page
      </p>
      <div class="not-found__actions">
        <a class="btn btn--primary" href="/">Back to the overview</a>
        <a class="btn" href="/architecture">Technical overview</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .not-found__inner {
    position: relative;
    text-align: center;
    max-width: 40rem;
  }

  .not-found .lede {
    margin-inline: auto;
  }

  .not-found__trace {
    font-size: 0.78rem;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
</style>
